# Three copies of this, one per environment (README, "Local, test and live"):
#   .env.local  this computer, embedded database: leave DATABASE_URL/DIRECT_URL empty
#   .env.test   the test Supabase project   (npm run dev:test, npm run db:migrate:test)
#   .env.live   the real site's own project (npm run db:migrate:live); the hosting's Production variables hold the same
#
# Supabase -> Project -> Connect
# Shared Pooler (transaction mode): used by the app
DATABASE_URL=postgresql://postgres.ntnxnbalbskwnmwskuvz:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432; the "Direct connection" address is IPv6-only on the free plan): used only for
# migrations, by npm run build on every deploy and by npm run db:migrate*
DIRECT_URL=postgresql://postgres.ntnxnbalbskwnmwskuvz:BmqQfCh2bFsR3m9I@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Photos (optional): Supabase -> Project Settings -> API Keys. The secret key (sb_secret_...) stays on the server; the
# app makes a private bucket on first use. Without these, development keeps photos in ./.data/photos and production
# has none. The publishable key is not used. An older project's service_role key works as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=photos

# Login. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's own address: http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=http://localhost:3000

# Development only: where the embedded PGlite database lives when DATABASE_URL is unset (default ./.data/alta-dev).
# To start fresh beside a running `next dev`: create the folder first with
#   ALTA_DEV_DB_DIR=./.data/alta-fresh node scripts/dev-db.mjs
# and only then set it here; the server picks the change up without a restart. Setting it first would let the
# server create an empty database before the script has migrated it.
# ALTA_DEV_DB_DIR=./.data/alta-dev

# Optional. With an AI key, "ফাইল থেকে ভরুন" on the biodata form sends the photo or PDF to a model, which reads
# handwriting, designed layouts and prose far better than the free in-browser path (text extraction + OCR + rules)
# used when both are empty. If the AI is busy or fails, the browser falls back to reading the file itself.
#
# Free: a Gemini key from https://aistudio.google.com (no card). The free tier allows a handful of requests a minute
# and a few hundred a day, plenty for one ghotok. Default model gemini-3.5-flash-lite, which answers in seconds;
# the bigger Flash models think past the 45 seconds a form waits.
GEMINI_API_KEY=
# Paid, the stronger reader: an Anthropic key. Used instead of Gemini when both are set. About 1-2 taka per biodata
# on the default model, claude-opus-5-5.
ANTHROPIC_API_KEY=
# Overrides either provider's default model.
# BIODATA_AI_MODEL=

# Normally empty: the ghotok becomes the site's owner and admin at /setup, and makes helpers admins from
# /dashboard/customers. Comma-separated phone numbers here are admins as well, whatever the database says: the way
# back in should the ghotok ever lose access.
ADMIN_PHONES=

# News on the phone (Web Push), free: the browsers' own push services deliver it. Development makes a key pair by
# itself (./.data/vapid.json); in production run `npm run vapid` once and paste both lines here. Without them the
# settings card is hidden and news waits in the bell. VAPID_SUBJECT is a contact for the push services (Apple asks).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
