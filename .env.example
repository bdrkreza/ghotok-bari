# Supabase -> Project -> Connect
# Shared Pooler (transaction mode): used by the app
DATABASE_URL=
# Direct connection: used only for migrations (npm run db:migrate)
DIRECT_URL=

# Login. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's own address: http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=http://localhost:3000

# Development only: where the embedded PGlite database lives when DATABASE_URL is unset (default ./.data/alta-dev).
# To start fresh beside a running `next dev`: create the folder first with
#   ALTA_DEV_DB_DIR=./.data/alta-fresh node scripts/dev-db.mjs
# and only then set it here; the server picks the change up without a restart. Setting it first would let the
# server create an empty database before the script has migrated it.
# ALTA_DEV_DB_DIR=./.data/alta-dev

# Comma-separated phone numbers whose accounts are admins (can open /admin); other admins can be made from that page
ADMIN_PHONES=
